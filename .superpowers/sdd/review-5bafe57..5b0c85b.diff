+    gap: 10px;
+    padding: 14px 18px;
+  }
+
+  .row2 .lbl {
+    font-family: var(--font-base);
+    font-size: 0.6rem;
+    letter-spacing: 0.14em;
+    text-transform: uppercase;
+    color: var(--color-text-muted);
+    white-space: nowrap;
+  }
+
+  .row2 input {
+    flex: 1;
